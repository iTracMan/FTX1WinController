<Window x:Class="FTX1WinController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FTX1WinController.Controls"
        xmlns:conv="clr-namespace:FTX1WinController.Converters"
        Title="FTX-1 Controller (Windows)" Height="1019" Width="1129" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
        <!-- Width trimmed from 1180 to match the now-compact fixed-width
             content (widest row — Row 1 — needs ~1114px including outer
             margins; 1140 leaves a little slack for window chrome).
             ResizeMode was "NoResize" (per user request 2026-09-05) because
             every row is Auto/fixed-width rather than stretchy, so resizing
             narrower used to just clip content. Now the whole layout below
             is wrapped in a single Viewbox (2026-09-07, ahead of public
             release — other people's monitors won't all fit a fixed
             1129x1019 window), which scales this entire fixed-shape layout
             uniformly to whatever size the window becomes, so resizing no
             longer clips — it shrinks/grows the whole thing proportionally
             instead. Height/Width here are now just this layout's *natural*
             (1:1 scale) size, not a hard limit.
             Height=920 is this component's ideal size — MainWindow.xaml.cs
             (PositionOnSecondaryMonitorIfPresent) now opens the window
             directly on the user's larger secondary monitor when one is
             attached (their actual workflow: laptop + external monitor,
             confirmed 2026-09-05), clamping Height/Width down only if that
             target screen's own working area genuinely can't fit 920 —
             which is why this can stay at the larger ideal value instead
             of being pre-shrunk for the laptop screen the app used to
             always open on. WindowStartupLocation="CenterScreen" here is
             just the fallback for the single-monitor case; the code-behind
             overrides it to Manual whenever it repositions. -->

    <Window.Background>
        <SolidColorBrush Color="White" />
    </Window.Background>

    <Window.Resources>

        <!-- Colors ported from the Mac app's RadioTheme.swift — see
             CLAUDE.md's "Colors (from RadioTheme.swift)" section. Keep
             this list and RadioTheme.swift in sync if either changes. -->
        <SolidColorBrush x:Key="ChassisTopBrush" Color="#292B31" />
        <SolidColorBrush x:Key="ChassisBottomBrush" Color="#17191C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#21242A" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#99000000" />
        <SolidColorBrush x:Key="BezelHighlightBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#050D0B" />
        <SolidColorBrush x:Key="DisplayTextBrush" Color="#8CF2D9" />
        <SolidColorBrush x:Key="DisplayDimBrush" Color="#4C8C80" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F2A626" />
        <SolidColorBrush x:Key="MeterBlueBrush" Color="#8CB8FA" />
        <SolidColorBrush x:Key="LedOffBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="LedGreenBrush" Color="#59EB73" />
        <SolidColorBrush x:Key="LedYellowBrush" Color="#FAD940" />
        <SolidColorBrush x:Key="LedRedBrush" Color="#FA4C47" />
        <SolidColorBrush x:Key="LabelSecondaryBrush" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="LabelPrimaryBrush" Color="#EBFFFFFF" />

        <!-- radioPanel() chrome — replaces GroupBox's default frame. Two
             stacked rounded-rect borders (outer panelBorder, inner inset-by-1
             bezelHighlight) is what gives the "inset into the chassis" bevel
             look; the header content becomes a small uppercase-ish label
             above the body rather than GroupBox's native header chrome. -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <!-- Without this, a child's DropShadowEffect (e.g. the PTT
                 button's) can render a few pixels past the box's own
                 Arrange bounds, making a box that's ACTUALLY the right
                 height still look like it overhangs its neighbor. -->
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" />
                            <Border BorderBrush="{StaticResource BezelHighlightBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="1" />
                            <StackPanel Margin="12">
                                <ContentPresenter ContentSource="Header"
                                                   Margin="0,0,0,8"
                                                   TextElement.Foreground="{StaticResource LabelSecondaryBrush}"
                                                   TextElement.FontSize="11"
                                                   TextElement.FontWeight="SemiBold" />
                                <ContentPresenter />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButtonStyle chrome (CLAUDE.md "Two button styles") —
             registered as the default Button/RepeatButton style so every
             plain button (Connect, Set, QMB Recall/Store, +/- steppers,
             etc.) gets the radio look for free. Toggle-style buttons below
             layer an Active/On DataTrigger on top via BasedOn. Shadow
             "lifts up" when idle and tightens on press by swapping between
             two DropShadowEffect resources (WPF can't animate into an
             Effect's sub-properties via a plain Setter). -->
        <DropShadowEffect x:Key="ButtonShadowIdle" Color="Black" Direction="270" ShadowDepth="2" BlurRadius="5" Opacity="0.45" />
        <DropShadowEffect x:Key="ButtonShadowPressed" Color="Black" Direction="270" ShadowDepth="0.5" BlurRadius="2" Opacity="0.3" />
        <!-- ScaleTransform is a Freezable, not a FrameworkElement — a
             ControlTemplate.Trigger's Setter TargetName can't reach into
             one of its sub-properties (ScaleX/ScaleY) directly, so the
             press-scale is done the same way as the shadow: swap the whole
             RenderTransform object between two resources. -->
        <ScaleTransform x:Key="ScaleIdle" ScaleX="1" ScaleY="1" />
        <ScaleTransform x:Key="ScalePressed" ScaleX="0.97" ScaleY="0.97" />

        <ControlTemplate x:Key="RadioButtonTemplate" TargetType="ButtonBase">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#80000000"
                    BorderThickness="1"
                    CornerRadius="5"
                    Effect="{StaticResource ButtonShadowIdle}"
                    RenderTransform="{StaticResource ScaleIdle}"
                    RenderTransformOrigin="0.5,0.5">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Effect" Value="{StaticResource ButtonShadowPressed}" />
                    <Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource ScalePressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}" />
            <Setter Property="Background" Value="#17FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="RepeatButton">
            <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}" />
            <Setter Property="Background" Value="#17FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <!-- ToggleButton reuses RadioButtonTemplate too (ButtonBase-targeted,
             so IsPressed/IsEnabled triggers work the same way) — used for
             the Settings popover toggle. -->
        <Style TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}" />
            <Setter Property="Background" Value="#17FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource LabelPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- RadioModeButtonStyle — Mode and Band panels ONLY (see
             CLAUDE.md); every other button uses the default Button style
             above. Idle state is a light gradient (matches the radio's own
             physical mode/band keys), swapping to a solid blue fill with a
             thicker orange-red border when selected — different enough
             from the dark chassis look that it gets its own template
             rather than reusing RadioButtonTemplate. -->
        <ControlTemplate x:Key="RadioModeButtonTemplate" TargetType="Button">
            <Border x:Name="Root"
                    BorderBrush="#D8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource ButtonShadowIdle}"
                    RenderTransform="{StaticResource ScaleIdle}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EDEEEE" Offset="0" />
                        <GradientStop Color="#9EA6A6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextElement.Foreground="Black" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Effect" Value="{StaticResource ButtonShadowPressed}" />
                    <Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource ScalePressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#0A4DFA" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="#F25C4F" />
                    <Setter TargetName="Root" Property="BorderThickness" Value="2.5" />
                    <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RadioModeButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RadioModeButtonTemplate}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                    <Setter Property="Foreground" Value="#D9000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Same look as ToggleButtonStyle but triggered on IsOn instead of
             IsActive — ToggleSettingViewModel (SettingViewModels.cs) exposes
             IsOn, not IsActive, since "active" reads oddly for a plain on/
             off setting like ATT or VOX. -->
        <Style x:Key="ToggleOnStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                    <Setter Property="Foreground" Value="#D9000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- MEM's armed state is a local timer, not a bridge-synced
             ToggleSettingViewModel (see MainViewModel.MessageArmed) — red
             like the Mac app's own RadioTheme.ledRed, so it reads as
             distinct from a plain amber "on" toggle. -->
        <Style x:Key="MemArmedStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageArmed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LedRedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Record's Command is MainViewModel.RecordCommand (fires both
             SET SDRECORDING and SET RECORD), but its on/off *state* is
             still SdRecording.IsOn (the radio's own SD-card flag, the
             single source of truth since both halves start together) —
             referenced via the full property path since this button's own
             DataContext stays the window's, unlike ToggleOnStyle's items
             which sit inside a ToggleSettingViewModel-DataContext'd
             ItemsControl template. -->
        <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SdRecording.IsOn}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LedRedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Same shape as RecordButtonStyle — Split's button sits directly
             in the window's own DataContext, so its style trigger needs
             the full "Split.IsOn" path rather than a bare "IsOn". -->
        <Style x:Key="SplitButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Split.IsOn}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                    <Setter Property="Foreground" Value="#D9000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- FUNC-grid "raised key" cells (CLAUDE.md's GridCellShell) —
             two-line label/value button, olive-grey gradient, border drawn
             inside the cell bounds (WPF Border is inside-drawn by default,
             so this needed no extra work to match SwiftUI's strokeBorder).
             Toggle cells swap border to amber + value text ON/OFF via a
             DataTrigger on the templated Button's own DataContext (the
             ToggleSettingViewModel item), same technique already proven by
             RadioModeButtonTemplate's IsActive trigger above. -->
        <DataTemplate x:Key="FuncToggleCellTemplate">
            <Button Command="{Binding ToggleCommand}" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#575749" Offset="0" />
                                    <GradientStop Color="#2C2525" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="White"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" />
                                <TextBlock x:Name="ValueText" Text="OFF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cell" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="ValueText" Property="Text" Value="ON" />
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Same cell chrome for a plain numeric setting (IntSettingViewModel:
             Label/DisplayText/Up/DownCommand) — no popover-based adjuster
             yet (see CLAUDE.md's VFODial note on the Mac app's tap-to-open
             pattern), so the +/- steppers stay as visible flanking buttons
             rather than living inside a tap target. -->
        <DataTemplate x:Key="FuncSliderCellTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,6,6" VerticalAlignment="Center">
                <RepeatButton Content="-" Command="{Binding DownCommand}" Width="26" MinWidth="26" Padding="0" Margin="0,0,3,0" Delay="1000" Interval="120" />
                <Border CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000" Width="72" MinHeight="40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#575749" Offset="0" />
                            <GradientStop Color="#2C2525" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" />
                        <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <RepeatButton Content="+" Command="{Binding UpCommand}" Width="26" MinWidth="26" Padding="0" Margin="3,0,0,0" Delay="1000" Interval="120" />
            </StackPanel>
        </DataTemplate>

        <conv:SliderPreviewConverter x:Key="SliderPreviewConverter" />

        <!-- FUNC-grid popup-slider cell (see chat 2026-09-04): replaces the
             flanking -/+ RepeatButtons with a single tappable cell that
             opens a popover containing an actual Slider, matching the Mac
             app's own tap-to-open-adjuster pattern (design-reference
             screenshots) and freeing up horizontal space in the grid.
             Dragging the slider only updates the LIVE preview text (via
             SliderPreviewConverter, reading the Slider's own uncommitted
             Value) — the actual "SET" only fires once on mouse-up
             (MainWindow.FuncSlider_DragCompleted), not on every drag pixel,
             to avoid flooding the bridge with rapid CAT commands. The
             popover stays open across multiple drags (StaysOpen="False"
             only closes on an outside click, not on internal interaction),
             unlike the choice-cell popover which closes on selection. -->
        <DataTemplate x:Key="FuncSliderPopupCellTemplate">
            <Grid>
                <ToggleButton x:Name="CellToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#575749" Offset="0" />
                                        <GradientStop Color="#2C2525" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" />
                                    <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=CellToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=CellToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel Margin="16" Width="200">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <Slider x:Name="ValueSlider" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=OneWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" PreviewMouseLeftButtonUp="FuncSlider_DragCompleted" />
                            <TextBlock Foreground="{StaticResource AmberBrush}" FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SliderPreviewConverter}">
                                        <Binding ElementName="ValueSlider" Path="Value" />
                                        <Binding />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- FUNC-grid choice cell (IPO/AGC/ANT — see chat 2026-09-04): same
             GridCellShell chrome as the toggle/slider cells, but tapping it
             opens a popover listing the available options (matching the
             Mac app's own tap-to-open pattern, and the real radio's own
             touchscreen behavior) instead of cycling in place. Works for
             both ChoiceSettingViewModel&lt;T&gt; (AGC/ANT) and
             ChoiceCellViewModel (IPO's PreampOptions adapter) — both
             expose the same Label/CurrentDisplayName/Options shape.
             Selecting an option closes the popover via MainWindow's
             ChoiceOption_Click, which walks up to the enclosing Popup. -->
        <DataTemplate x:Key="FuncChoiceCellTemplate">
            <Grid>
                <ToggleButton x:Name="CellToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#575749" Offset="0" />
                                        <GradientStop Color="#2C2525" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="White"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" />
                                    <TextBlock Text="{Binding CurrentDisplayName}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=CellToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=CellToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="220" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}"
                                                Style="{StaticResource ToggleButtonStyle}" Click="ChoiceOption_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <StackPanel Margin="16">

            <!-- Row 1 (CLAUDE.md layout): Display (frequency + meters) |
                 Connection status + PTT | Clock, side by side — matches the
                 Mac app's top row. The Display column reuses the 480px
                 Band/Mode column width from the row below so the two line
                 up. -->
            <!-- Column 1 is Auto (not "*"): a Star column's actual width
                 still depends on the window's current width, so a
                 fixed-width child inside it (box2) could get clipped by a
                 narrower window even though it no longer visibly stretches
                 — Auto sizes the column to box2's own content instead,
                 independent of window size (per user report 2026-09-05:
                 "chopped off half of box2"). Column 2 (Clock) removed —
                 box3 lives next to box4 now. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <GroupBox x:Name="DisplayGroupBox" Grid.Column="0" Foreground="White">
                    <StackPanel Margin="6">
                        <Border Background="{StaticResource DisplayBackgroundBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                            <TextBlock Text="{Binding FrequencyDisplay}" Foreground="{StaticResource DisplayTextBrush}" FontSize="32" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                        <controls:RadioArcMeterView Kind="SMeter" Value="{Binding SMeterValue, Mode=OneWay}" MaxValue="255" Height="27" Margin="0,0,0,4" />
                        <controls:RadioArcMeterView Kind="PowerOutput" Value="{Binding PowerOutputValue, Mode=OneWay}" MaxValue="255" Height="27" Margin="0,0,0,8" />
                        <controls:RadioVolMeterView Value="{Binding AfGain, Mode=OneWay}" MaxValue="255" RailColor="#FA4C47" Label="VOL" Height="18" Margin="0,0,0,4" />
                        <controls:RadioVolMeterView Value="{Binding RfOrSquelchValue, Mode=OneWay}" MaxValue="255" RailColor="#FAD940" Label="{Binding RfOrSquelchLabel}" Height="18" />
                    </StackPanel>
                </GroupBox>

                <!-- Height pinned directly to the Display box's own rendered
                     height. Grid/Stretch alone wasn't leveling this box's
                     bottom edge with Display's even after trimming this
                     box's own content (confirmed on hardware 2026-09-05,
                     twice) — binding straight to DisplayGroupBox's
                     ActualHeight sidesteps whatever's causing that instead
                     of fighting it further. -->
                <!-- Width=582, HorizontalAlignment="Left": this box was the
                     only one still Stretch-sized to its Grid column (the
                     "*" column, which grows/shrinks with the window), so it
                     was the one visibly resizing. Its left edge already
                     sits at x=490 (480 column0 + its own 10px margin) —
                     the same x box7's left edge sits at — so 582 (matching
                     box7's own content width) lands both boxes' right edges
                     on the same x (per user request 2026-09-05). -->
                <GroupBox Grid.Column="1" Foreground="White" Margin="10,0"
                          Height="{Binding ActualHeight, ElementName=DisplayGroupBox}"
                          Width="582" HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                    <StackPanel Margin="6">

                        <!-- 2x2 grid matching the Mac app's own Connection box:
                             status (top-left) + Connect/Disconnect (top-right),
                             Settings (bottom-left) + Presets (bottom-right) —
                             both columns and both rows aligned. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,6">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource LedOffBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                    <Setter Property="Fill" Value="{StaticResource LedGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionState}" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>

                            <!-- Single Connect/Disconnect button, swapping
                                 Content/Command by ConnectionState — same
                                 shape as the PTT button's state swap. -->
                            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="4,0,0,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <!-- Content/Command set here as plain Setters, NOT as local
                                             attributes on the Button itself — a local value always
                                             wins over a style trigger's Setter in WPF, which is why
                                             the DataTrigger below couldn't override them when they
                                             were local attributes (confirmed on hardware 2026-09-04:
                                             button stayed stuck on "Connect" after connecting). Same
                                             pattern as the PTT button below. -->
                                        <Setter Property="Content" Value="Connect" />
                                        <Setter Property="Command" Value="{Binding ConnectCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                <Setter Property="Content" Value="Disconnect" />
                                                <Setter Property="Command" Value="{Binding DisconnectCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Settings — Bridge (Mac) host/port/CAT config,
                                 tucked behind a popover like the Mac app's own
                                 Settings button (see design-reference
                                 02-settings-popover.png). -->
                            <ToggleButton Grid.Row="1" Grid.Column="0" x:Name="SettingsToggle" Content="Settings"
                                          HorizontalAlignment="Stretch" Margin="0,0,4,0" />

                            <!-- Presets — placeholder popover; behavior (what a
                                 preset captures/does) is pending user input,
                                 not yet wired to any command. -->
                            <ToggleButton Grid.Row="1" Grid.Column="1" x:Name="PresetsToggle" Content="Presets"
                                          HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                        </Grid>

                        <!-- Collapsed entirely when there's nothing to show —
                             otherwise this box was always a bit taller than
                             the Display/meter box next to it even with no
                             error present (confirmed on hardware
                             2026-09-05). -->
                        <TextBlock Text="{Binding LastError}" Foreground="{StaticResource LedRedBrush}" Margin="0,0,0,10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=SettingsToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                </Border.Effect>
                                <StackPanel Margin="14" Width="360">
                                    <TextBlock Text="CAT SERIAL CONNECTION" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="CAT-1 port:" VerticalAlignment="Center" Foreground="White" Width="70" />
                                        <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding SelectedCat1Port, UpdateSourceTrigger=PropertyChanged}" Width="180" IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Baud:" VerticalAlignment="Center" Foreground="White" Width="70" />
                                        <TextBox Text="{Binding Cat1Baud, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="CAT-2 port:" VerticalAlignment="Center" Foreground="White" Width="70" />
                                        <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding SelectedCat2Port, UpdateSourceTrigger=PropertyChanged}" Width="180" IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Baud:" VerticalAlignment="Center" Foreground="White" Width="70" />
                                        <TextBox Text="{Binding Cat2Baud, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    </StackPanel>
                                    <TextBlock Text="(CAT-2 optional — leave blank to route PTT over CAT-1)" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <Button Content="Refresh Ports" Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Left" />

                                    <TextBlock Text="AUDIO INPUT (RADIO)" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Device:" VerticalAlignment="Center" Foreground="White" Width="70" />
                                        <ComboBox ItemsSource="{Binding AvailableAudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice}" Width="180" />
                                    </StackPanel>
                                    <TextBlock Text="(the FTX-1's own USB audio interface, used by MONITOR/RECORD)" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Button Content="Refresh Audio Devices" Command="{Binding RefreshAudioDevicesCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Popup IsOpen="{Binding IsChecked, ElementName=PresetsToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=PresetsToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                </Border.Effect>
                                <StackPanel Margin="14" Width="280">
                                    <TextBlock Text="PRESETS" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />

                                    <!-- App-level save/recall of every FUNC
                                         Page 1/2 + Scan/Split setting plus
                                         frequency/mode/D-Level/RF Power/
                                         Preamp — NOT the FTX-1's own
                                         [PRESET] button (that's FT8-only
                                         config, unrelated). -->
                                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Content="Recall" Command="{Binding RecallCommand}" Padding="8,4" Margin="4,0,0,0" />
                                                    <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}" Padding="8,4" Margin="4,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No presets saved yet." Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" Margin="0,0,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                        <Button Content="Save" Command="{Binding SavePresetCommand}" Padding="8,4" Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- PTT — always-active RadioButtonStyle (see CLAUDE.md
                             "PTT button"): default chrome/shadow/press-scale
                             from the default Button style, tint + label
                             swapped by state. -->
                        <Button Command="{Binding TogglePttCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,14" FontSize="14" FontWeight="Black"
                                Background="{StaticResource LedGreenBrush}" Foreground="#D9000000">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="RECEIVE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                            <Setter Property="Content" Value="ON THE AIR" />
                                            <Setter Property="Background" Value="{StaticResource LedRedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </GroupBox>

            </Grid>

            <!-- VFO Controls — the Mac app's dial cluster: QMB/CLAR/Scan-
                 Split/Fine-Fast as four quadrant panels wrapped around the
                 dial, plus the Clar Offset stepper in the top-right corner
                 (design-reference screenshot, 2026-09-04). The knob
                 (VfoDialView) is a relative encoder like the real
                 hardware — dragging or scrolling it fires VfoStepUp/
                 DownCommand (MainWindow.VfoDial_Stepped); it has no
                 absolute position tied to frequency. -->
            <!-- Box4 (VFO Controls) and box3 (Clock) share a row here so
                 box3's top lines up with box4's — box3 moved out of Row 1
                 (per user request 2026-09-05) into the width box4/7/8's
                 narrowing freed up on the right. -->
            <!-- Column 1 Auto, same reason as Row 1's: a Star column can
                 shrink narrower than box3's fixed content on a smaller
                 window, clipping it even though it no longer stretches. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

            <!-- Own compact template (rather than the shared radioPanel()
                 Style's 12px padding + 8px header spacer) so the gap above
                 CLAR / below Fine-Fast can be trimmed to ~5px each side —
                 the shared template's fixed chrome padding can't be
                 tuned per-instance (per user request 2026-09-05: "roughly
                 5pt above CLAR and 5pt below Fine/Fast"). -->
            <!-- Top margin negative: Row 1's own Grid already contributes
                 10px (its own bottom margin) plus box1/2/3's own 10px
                 GroupBox margin baked into that Grid's height, so with
                 0 here the gap to box1 was ~20px. -10 here cancels the
                 Grid's own 10px, landing the total gap at 10px (per user
                 request 2026-09-05: "set the gap between box4 and box1 to
                 10px by moving box4"). -->
            <!-- Width=688, HorizontalAlignment="Left": without these box4
                 stretches to fill the outer StackPanel's full width. 688 is
                 CLAR's own right edge (670px from box4's left border) + 18,
                 matching the same 18px inset already measured on the
                 Direct Entry box's left side (per user request
                 2026-09-05). -->
            <GroupBox Grid.Column="0" Foreground="White" Margin="0,-10,0,0" Width="688" HorizontalAlignment="Left">
                <GroupBox.Template>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" />
                            <Border BorderBrush="{StaticResource BezelHighlightBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="1" />
                            <ContentPresenter Margin="12,1,12,1" />
                        </Grid>
                    </ControlTemplate>
                </GroupBox.Template>
                <StackPanel Margin="6,0,6,0">

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Direct Entry + AF/RF/SQL, moved out of the
                             Display meter panel into their own left-hand
                             column here to match the Mac app's own VFO
                             Controls layout (design reference 2026-09-04).
                             The numeric readout that used to sit between
                             the sub-dial's -/+ is dropped — the meter
                             above already shows any adjustment live. -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="DIRECT ENTRY" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Text="{Binding DirectEntryText, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                        <TextBlock Text="MHz" Foreground="{StaticResource LabelSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />
                                        <Button Content="Set" Command="{Binding SetFrequencyCommand}" Padding="10,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="AF" Command="{Binding SelectAfCommand}" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubDialTarget}" Value="Af">
                                                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                                                    <Setter Property="Foreground" Value="#D9000000" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="RF" Command="{Binding SelectRfCommand}" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubDialTarget}" Value="Rf">
                                                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                                                    <Setter Property="Foreground" Value="#D9000000" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="SQL" Command="{Binding SelectSqlCommand}" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubDialTarget}" Value="Sql">
                                                    <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                                                    <Setter Property="Foreground" Value="#D9000000" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <RepeatButton Content="-" Command="{Binding SubDialDownCommand}" Padding="8,2" Margin="0,0,4,0" Delay="1000" Interval="120" />
                                <RepeatButton Content="+" Command="{Binding SubDialUpCommand}" Padding="8,2" Delay="1000" Interval="120" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="VFO Step:" Foreground="White" Width="70" VerticalAlignment="Center" />
                                <RepeatButton Content="-" Command="{Binding VfoStepDownCommand}" Padding="8,2" Margin="0,0,6,0" Delay="1000" Interval="120" />
                                <RepeatButton Content="+" Command="{Binding VfoStepUpCommand}" Padding="8,2" Delay="1000" Interval="120" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Quadrant grid + dial, layered in the same Grid
                             cell so the dial (added last) renders on top,
                             centered over where all four quadrants meet.
                             Plain rounded-rect panels (chamfered-corner
                             experiment reverted 2026-09-04 per design
                             reference) sized wide/short (landscape) rather
                             than square. -->
                        <Grid Grid.Column="1" Width="416" Height="226" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <!-- QMB — tap to Recall, press-and-hold to
                                 Store. Plain Border (not Button) with
                                 manual mouse handling so tap-vs-hold can be
                                 distinguished — ButtonBase only has one
                                 Click gesture. -->
                            <Border Grid.Row="0" Grid.Column="0" Width="200" Height="105" Margin="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    PreviewMouseLeftButtonDown="QmbQuadrant_MouseDown" PreviewMouseLeftButtonUp="QmbQuadrant_MouseUp" Cursor="Hand">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <TextBlock Text="QMB" Foreground="{StaticResource LabelPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="tap/hold" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CLAR — tap opens a popover with the on/off
                                 cycle button AND the Clar Offset stepper
                                 together (folded in from its own top-corner
                                 control per chat 2026-09-04), same
                                 tap-to-open pattern as the other quadrants. -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="4">
                                <ToggleButton x:Name="ClarToggle" Width="200" Height="105">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="QuadCell" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                                                    <TextBlock Text="CLAR" Foreground="{StaticResource LabelPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ClarifierStatusText}" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="QuadCell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter TargetName="QuadCell" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=ClarToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=ClarToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                        </Border.Effect>
                                        <StackPanel Margin="16">
                                            <TextBlock Text="CLAR" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                                            <Button Content="{Binding ClarifierStatusText}" Command="{Binding CycleClarifierCommand}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Offset" Foreground="{StaticResource LabelSecondaryBrush}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding ClarifierOffsetHz, StringFormat={}{0} Hz}" Foreground="{StaticResource LabelSecondaryBrush}" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Width="50" TextAlignment="Right" Margin="0,0,4,0" />
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <RepeatButton Content="▲" Command="{Binding ClarifierOffsetUpCommand}" Width="18" Height="13" Padding="0" FontSize="7" Delay="1000" Interval="120" />
                                                    <RepeatButton Content="▼" Command="{Binding ClarifierOffsetDownCommand}" Width="18" Height="13" Padding="0" FontSize="7" Margin="0,1,0,0" Delay="1000" Interval="120" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Scan/Split — tap opens the full Scan/Split
                                 panel (moved here from the old standalone
                                 Scan/Split GroupBox, content unchanged) in
                                 a popover, same tap-to-open pattern as the
                                 FUNC grid's choice cells. -->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="4">
                                <ToggleButton x:Name="ScanSplitToggle" Width="200" Height="105">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="QuadCell" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                                                    <TextBlock Text="Scan/Split" Foreground="{StaticResource LabelPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                                                    <TextBlock Text="tap" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="QuadCell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter TargetName="QuadCell" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=ScanSplitToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=ScanSplitToggle}"
                                       Placement="Right" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                        </Border.Effect>
                                        <StackPanel Margin="16" Width="380">
                                            <TextBlock Text="SCAN / SPLIT" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Scan" Foreground="White" Width="60" VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding Scan.Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Style="{StaticResource ToggleButtonStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Split" Foreground="White" Width="60" VerticalAlignment="Center" />
                                                <Button Content="{Binding Split.Label}" Command="{Binding Split.ToggleCommand}" Style="{StaticResource SplitButtonStyle}" Margin="0,0,10,0" />
                                                <TextBlock Text="TX" Foreground="White" Width="30" VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding TxSide.Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Style="{StaticResource ToggleButtonStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="VFO-B" Foreground="White" Width="60" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding SubFrequencyEntryText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                                <TextBlock Text="MHz" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <Button Content="Set" Command="{Binding SetSubFrequencyCommand}" Padding="8,2" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding SubFrequencyDisplay}" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                <TextBlock Text="Shift" Foreground="White" Width="60" VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding RepeaterShift.Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Style="{StaticResource ToggleButtonStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Tone" Foreground="White" Width="60" VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding ToneType.Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Style="{StaticResource ToggleButtonStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding CtcssIndex.Label}" Foreground="White" Width="110" VerticalAlignment="Center" />
                                                <RepeatButton Content="-" Command="{Binding CtcssIndex.DownCommand}" Padding="8,2" Margin="0,0,4,0" Delay="1000" Interval="120" />
                                                <TextBlock Text="{Binding CtcssIndex.DisplayText}" Foreground="White" VerticalAlignment="Center" Width="70" TextAlignment="Center" />
                                                <RepeatButton Content="+" Command="{Binding CtcssIndex.UpCommand}" Padding="8,2" Margin="4,0,0,0" Delay="1000" Interval="120" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DcsIndex.Label}" Foreground="White" Width="110" VerticalAlignment="Center" />
                                                <RepeatButton Content="-" Command="{Binding DcsIndex.DownCommand}" Padding="8,2" Margin="0,0,4,0" Delay="1000" Interval="120" />
                                                <TextBlock Text="{Binding DcsIndex.DisplayText}" Foreground="White" VerticalAlignment="Center" Width="70" TextAlignment="Center" />
                                                <RepeatButton Content="+" Command="{Binding DcsIndex.UpCommand}" Padding="8,2" Margin="4,0,0,0" Delay="1000" Interval="120" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Fine/Fast — tap cycles OFF -> FINE -> FAST -> OFF. -->
                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding CycleFineTuningCommand}" Margin="4" Width="200" Height="105">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="Fine/Fast" Foreground="{StaticResource LabelPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FineTuningDisplayName}" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <controls:VfoDialView x:Name="VfoDial" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsClarifierActive="{Binding ClarifierActive}" Stepped="VfoDial_Stepped"
                                                   Cursor="SizeAll" />
                        </Grid>
                    </Grid>

                </StackPanel>
            </GroupBox>

                <!-- Clock — local UTC display, code-behind only
                     (MainWindow.xaml.cs), not bridge-synced; purely visual,
                     touches no ViewModel/bridge wiring. Moved out of Row 1
                     (per user request 2026-09-05) so its top lines up with
                     box4's instead. -->
                <!-- Margin left 10: gap to box4 (per user request 2026-09-05).
                     Width 374 + HorizontalAlignment="Left": box3's left edge
                     lands at 698 (688 box4 width + this 10px gap), so 374
                     brings its right edge to 1072 — the same x box7's right
                     edge sits at (490 left edge + its own 582px content
                     width), aligning the two. -->
                <!-- Top margin -10 to match box4's own -10: box4 pokes 10px
                     above the shared row's nominal top (that negative
                     margin is what levels IT with box1 above), so box3
                     needs the same offset to actually match box4's real
                     visual top instead of sitting 10px below it (per user
                     request 2026-09-05). -->
                <!-- box3 wrapped in a StackPanel (same Grid.Column/Margin/
                     alignment box3 had directly before) so the new
                     placeholder box can stack below it without moving
                     box3 or box4 — the placeholder fills the gap to the
                     right of box4 / below box3 (per user request
                     2026-09-05). -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,-10,0,0">
                    <GroupBox Foreground="White" Width="374" Margin="0">
                        <StackPanel Margin="6,10" HorizontalAlignment="Center">
                            <TextBlock Text="UTC" Foreground="{StaticResource LabelSecondaryBrush}"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="{StaticResource DisplayTextBrush}"
                                       FontSize="68" FontFamily="Consolas" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </GroupBox>

                    <!-- MONITOR — Live passthrough of the FTX-1's received
                         audio (its USB audio interface, captured via
                         LiveAudioService) out to this Windows machine's
                         default output device. Independent of RECORD. -->
                    <Button Command="{Binding ToggleAudioMonitorCommand}" Width="374" Height="80" Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Cell" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="MONITOR" Foreground="{StaticResource LabelPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AudioMonitorStatusText}" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding AudioMonitorOn}" Value="True">
                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                        <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 3 (CLAUDE.md layout): Band+Mode stacked in a fixed
                 480px column, beside FUNC Page 1 + FUNC Page 2 stacked in
                 an Auto-sized column (not "*" — same reason as Row 1/box4's:
                 a Star column can shrink narrower than box7/8's fixed
                 content on a smaller window and clip them) — Page 2
                 top-aligned with Mode's top.
                 No bottom margin here — this is the last row in the outer
                 StackPanel, so a trailing margin just adds asymmetric
                 whitespace below the window's content vs. above it
                 (confirmed on hardware 2026-09-05: this + box8's own
                 trailing margin below was tipping the ScrollViewer into
                 showing a scrollbar for a few pixels of pure slack). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Band -->
                    <GroupBox Header="Band" Foreground="White" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding BandButtons}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Style="{StaticResource RadioModeButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- Mode — a fixed 4x5 grid matching the real radio's own
                         mode button layout exactly, not a free-flowing wrap:
                         row 1 has one trailing blank, row 4 has two. A
                         UniformGrid also gives every button the same size
                         regardless of row length, unlike WrapPanel (which
                         let the last row's buttons size differently). The
                         blanks are real ModeButtonViewModel.Blank() entries
                         in ModeButtons (see MainViewModel), not missing
                         items — UniformGrid has no concept of "skip a cell",
                         so the placeholder has to be a real (invisible) child. -->
                    <GroupBox Header="Mode" Foreground="White" Margin="0">
                        <ItemsControl ItemsSource="{Binding ModeButtons}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RadioModeButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- FUNC Page 1 — a fixed 7-column grid matching the real
                         radio's own screen layout exactly (confirmed
                         2026-09-04, see reference screenshots), not a
                         free-flowing wrap. Cells with no child at a given
                         Row/Column are deliberate blanks — genuinely empty
                         on the real hardware too (MOX isn't implemented
                         here at all; (row2,col2) is blank on the radio
                         itself). Every slider is now a single tap-to-open
                         popup cell (FuncSliderPopupCellTemplate) instead of
                         flanking -/+ RepeatButtons, freeing up the width
                         this many columns needs. -->
                    <!-- HorizontalAlignment="Left": without this the box
                         stretches to fill the Row 3 "*" column (whatever
                         width is left in the window), which was much wider
                         than the 7 fixed 78px columns actually need. Left-
                         aligning shrinks it to its own content width, which
                         works out to exactly 21px past Dimmer (LED)'s right
                         edge — the same 12px template inset + 6px grid
                         margin + 3px button margin already measured on the
                         left side of D-LEVEL (per user request
                         2026-09-05). -->
                    <GroupBox Header="FUNC — Page 1" Foreground="White" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 1: D-LEVEL, D-PEAK, D-MARKER, D-COLOR, D-CONTRAST, DIMMER (TFT), DIMMER (LED) -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ToggleButton x:Name="DLevelToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#575749" Offset="0" />
                                                        <GradientStop Color="#2C2525" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                    <TextBlock Text="D-LEVEL" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                    <TextBlock Text="{Binding DLevel, StringFormat={}{0:+0.0;-0.0;0.0}}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=DLevelToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=DLevelToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                        </Border.Effect>
                                        <StackPanel Margin="16" Width="200">
                                            <TextBlock Text="D-LEVEL" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <Slider x:Name="DLevelSlider" Minimum="-30" Maximum="30" Value="{Binding DLevel, Mode=OneWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" PreviewMouseLeftButtonUp="DLevelSlider_DragCompleted" />
                                            <TextBlock Text="{Binding Value, ElementName=DLevelSlider, StringFormat={}{0:+0.0;-0.0;0.0}}" Foreground="{StaticResource AmberBrush}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding DPeak}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding DMarker}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="0" Grid.Column="3" Content="{Binding DColor}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="0" Grid.Column="4" Content="{Binding DContrast}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="0" Grid.Column="5" Content="{Binding DimmerBrightness}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="0" Grid.Column="6" Content="{Binding DimmerLed}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />

                            <!-- Row 2: [MOX — not implemented], ATT, IPO, DNF, AGC, MIC EQ, PROC LEVEL -->
                            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Attenuator}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding IpoCell}" ContentTemplate="{StaticResource FuncChoiceCellTemplate}" />
                            <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding AutoNotch}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="1" Grid.Column="4" Content="{Binding Agc}" ContentTemplate="{StaticResource FuncChoiceCellTemplate}" />
                            <ContentControl Grid.Row="1" Grid.Column="5" Content="{Binding MicEq}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="1" Grid.Column="6" Content="{Binding ProcLevel}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />

                            <!-- Row 3: ANT TUNE, TUNER, [blank], NB, DNR, ANT, TXW -->
                            <Button Grid.Row="2" Grid.Column="0" Command="{Binding AntTuneCommand}" Width="72" MinHeight="40" Margin="3,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.AutomationId="AntTuneButton">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#575749" Offset="0" />
                                                    <GradientStop Color="#2C2525" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="ANT TUNE" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" />
                                                <TextBlock Text="•" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding Tuner}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="2" Grid.Column="3" Content="{Binding NoiseBlanker}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="2" Grid.Column="4" Content="{Binding NoiseReduction}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="2" Grid.Column="5" Content="{Binding Ant}" ContentTemplate="{StaticResource FuncChoiceCellTemplate}" />
                            <ContentControl Grid.Row="2" Grid.Column="6" Content="{Binding Txw}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />

                            <!-- Row 4: RF POWER, MIC GAIN, AMC LEVEL, VOX, VOX GAIN, VOX DELAY -->
                            <Grid Grid.Row="3" Grid.Column="0">
                                <ToggleButton x:Name="RfPowerToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#575749" Offset="0" />
                                                        <GradientStop Color="#2C2525" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                    <TextBlock Text="RF POWER" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                    <TextBlock Text="{Binding RfPowerWatts, StringFormat={}{0}W}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=RfPowerToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=RfPowerToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                        </Border.Effect>
                                        <StackPanel Margin="16" Width="200">
                                            <TextBlock Text="RF POWER" Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <Slider x:Name="RfPowerSlider" Minimum="{Binding RfPowerMin}" Maximum="{Binding RfPowerMax}" Value="{Binding RfPowerWatts, Mode=OneWay}" TickFrequency="1" IsSnapToTickEnabled="True" PreviewMouseLeftButtonUp="RfPowerSlider_DragCompleted" />
                                            <TextBlock Text="{Binding Value, ElementName=RfPowerSlider, StringFormat={}{0:0}W}" Foreground="{StaticResource AmberBrush}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding MicGain}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="3" Grid.Column="2" Content="{Binding AmcLevel}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="3" Grid.Column="3" Content="{Binding Vox}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                            <ContentControl Grid.Row="3" Grid.Column="4" Content="{Binding VoxGain}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                            <ContentControl Grid.Row="3" Grid.Column="5" Content="{Binding VoxDelay}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                        </Grid>
                    </GroupBox>

                    <!-- FUNC Page 2 (CW) — same fixed-grid approach as Page 1,
                         same HorizontalAlignment="Left" fix so it shrinks to
                         its own 582px content width instead of stretching
                         to fill the "*" column — identical column/margin
                         structure to Page 1, so its right edge now lines up
                         with box7's automatically (per user request
                         2026-09-05). -->
                    <GroupBox Header="FUNC — Page 2 (CW)" Foreground="White" HorizontalAlignment="Left" Margin="0">
                        <StackPanel Margin="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 1: [blank], MONI LEVEL, [blank x5] -->
                                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding MoniLevel}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />

                                <!-- Row 2: KEYER, BK-IN, CW SPEED, CW PITCH, BK-DELAY, ZIN, CW SPOT -->
                                <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding Keyer}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding BreakIn}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding CwSpeed}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding CwPitch}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="4" Content="{Binding CwBreakInDelay}" ContentTemplate="{StaticResource FuncSliderPopupCellTemplate}" />
                                <Button Grid.Row="1" Grid.Column="5" Command="{Binding ZeroInCommand}" Width="72" MinHeight="40" Margin="3,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#575749" Offset="0" />
                                                        <GradientStop Color="#2C2525" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                    <TextBlock Text="ZIN" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                    <TextBlock Text="•" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ContentControl Grid.Row="1" Grid.Column="6" Content="{Binding CwSpot}" ContentTemplate="{StaticResource FuncToggleCellTemplate}" />

                                <!-- Row 3: [blank], MESSAGE, PLAY, RECORD, [blank x3] -->

                                <!-- MESSAGE — channel tap plays it back (or re-targets
                                     an in-progress MEM arm); MEM (inside this popover,
                                     matching the Mac app's own MESSAGE MEMORY popover)
                                     arms recording for whichever channel is selected,
                                     with a 5s auto-disarm (MessageArmed). See
                                     MainViewModel's own MESSAGE MEMORY comment. -->
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <ToggleButton x:Name="MessageToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#575749" Offset="0" />
                                                            <GradientStop Color="#2C2525" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                        <TextBlock Text="MESSAGE" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                        <TextBlock Text="{Binding MessageCell.CurrentDisplayName}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                        <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=MessageToggle, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=MessageToggle}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade">
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                            </Border.Effect>
                                            <StackPanel Margin="16">
                                                <TextBlock Text="MESSAGE MEMORY" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                                <ItemsControl ItemsSource="{Binding MessageChannelOptions}" HorizontalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}" Command="{Binding SelectCommand}" Click="ChoiceOption_Click"
                                                                    Width="60" MinHeight="50" Margin="3,0" FontSize="14" Style="{StaticResource ToggleButtonStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="MEM" Command="{Binding MessageArmCommand}" Style="{StaticResource MemArmedStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- PLAY — value shows how many recordings are stored
                                     (Recordings.Count, live via ObservableCollection);
                                     tapping opens the PLAY LIST popover to play (or,
                                     once wired, delete) an individual recording. See
                                     MainViewModel's own RECORD/PLAY comment: playback
                                     is remote-controlled here but the audio itself
                                     plays on the Mac's own speakers, since only the Mac
                                     has a USB audio path to the radio. -->
                                <Grid Grid.Row="2" Grid.Column="2">
                                    <ToggleButton x:Name="PlayToggle" Width="72" MinHeight="40" Margin="3,5" Padding="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#575749" Offset="0" />
                                                            <GradientStop Color="#2C2525" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                        <TextBlock Text="PLAY" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                        <TextBlock Text="{Binding Recordings.Count}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                        <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=PlayToggle, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=PlayToggle}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True" Popup.PopupAnimation="Fade"
                                           Opened="PlayListPopup_Opened">
                                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5" />
                                            </Border.Effect>
                                            <StackPanel Margin="16" Width="360">
                                                <TextBlock Text="PLAY LIST" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <ItemsControl ItemsSource="{Binding Recordings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="White" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <Button Grid.Column="1" Content="Play" Command="{Binding PlayCommand}" Padding="8,4" Margin="4,0,0,0" />
                                                                <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}" Padding="8,4" Margin="4,0,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="No recordings yet." Foreground="{StaticResource LabelSecondaryBrush}" FontSize="11" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Recordings.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Stop" Command="{Binding StopPlaybackCommand}" Padding="8,4" Margin="0,0,4,0" />
                                                    <TextBlock Text="Playing" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- RECORD — value stays "•" (matching the Mac app's
                                     own reference screenshots — it doesn't switch to
                                     an ON/OFF readout); the border/text still turns red
                                     while actually recording (SdRecording.IsOn), same
                                     red-for-armed/recording convention as MEM. -->
                                <Button Grid.Row="2" Grid.Column="3" Command="{Binding RecordCommand}" Width="72" MinHeight="40" Margin="3,5" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Cell" CornerRadius="4" BorderThickness="0.75" BorderBrush="#8C000000">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#575749" Offset="0" />
                                                        <GradientStop Color="#2C2525" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                                    <TextBlock Text="RECORD" FontSize="9" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                                                    <TextBlock x:Name="ValueText" Text="•" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SdRecording.IsOn}" Value="True">
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource LedRedBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource LedRedBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Viewbox>
</Window>
